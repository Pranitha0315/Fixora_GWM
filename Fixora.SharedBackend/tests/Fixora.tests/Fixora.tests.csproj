<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Host references every module, so the tests can use Customer/Manager/Shared types and WebApplicationFactory<Program>. -->
    <ProjectReference Include="..\..\src\Host\Fixora.Host\Fixora.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Parked: NID-only LocalDB atomic/Version/CrossContext suite — file kept, not compiled against Shared. -->
  <ItemGroup>
    <Compile Remove="Integration\InvitationAtomicAcceptanceTests.cs" />
  </ItemGroup>

</Project>
