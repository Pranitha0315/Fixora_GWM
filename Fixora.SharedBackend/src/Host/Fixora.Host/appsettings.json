{
  "ConnectionStrings": {
    "Fixora": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "Seed": true
  },
  "Jwt": {
    "Issuer": "fixora",
    "Audience": "fixora-apps",
    "SigningKey": "fixora-dev-signing-key-change-me-0123456789",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Customer": {
    "ExposeDevOtp": true,
    "OtpMinutes": 10,
    "TripRetentionDays": 90,
    "HeatmapMinVehicles": 3
  },
  "Ai": {
    "Provider": "Template",
    "AnthropicApiKey": "",
    "Model": "claude-haiku-5-5",
    "GeminiApiKey": "",
    "GeminiModel": "gemini-flash-lite-latest"
  },
  "Advisor": {
    "Provider": "Template"
  },
  "Stt": {
    "Provider": "None"
  },
  "Workers": {
    "Enabled": true
  },
  "Cors": {
    "Origins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
